# Postgres
DATABASE_URL=postgres://wagerflow:wagerflow@localhost:5432/wagerflow?sslmode=disable

# API HTTP
HTTP_PORT=8080

# Keycloak (OIDC). Porta 8081 porque é a que o docker-compose publica
# no HOST (o container escuta na 8080 interna, mas 8080 já é a porta
# padrão de muita coisa, então mapeamos para 8081 fora do container).
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/wagerflow

# Preenchido no próximo passo (SQS/LocalStack)
# AWS_SQS_ENDPOINT=

# ---
# Credenciais de DEV dos 3 clients já provisionados no realm (ver
# deployments/keycloak/realm-export.json) — não são lidas pela
# aplicação, são só para você pedir um token manualmente e testar as
# rotas. Uso (client_credentials):
#
#   curl -X POST http://localhost:8081/realms/wagerflow/protocol/openid-connect/token \
#     -d "grant_type=client_credentials" \
#     -d "client_id=provider-a" \
#     -d "client_secret=provider-a-secret"
#
# client_id=provider-a       secret=provider-a-secret       role=provider  (providerId="provider-a")
# client_id=provider-b       secret=provider-b-secret       role=provider  (providerId="provider-b")
# client_id=wagerflow-internal  secret=internal-secret      role=internal
